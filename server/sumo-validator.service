[Unit]
Description=Sumo Frog PRIVATE Solana test validator (worthless test network, localhost only)
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/sumo
ExecStart=/home/ubuntu/sumo/bin/solana-test-validator --quiet \
  --ledger /home/ubuntu/sumo/ledger \
  --bind-address 127.0.0.1 --rpc-port 8899 --faucet-port 9900 \
  --dynamic-port-range 8000-8030 \
  --limit-ledger-size 1000000 \
  --faucet-per-request-sol-cap 5 --faucet-per-time-sol-cap 50 --faucet-time-slice-secs 3600 \
  --bpf-program metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s /home/ubuntu/sumo/mpl_token_metadata.so
Restart=always
RestartSec=10
Nice=10
CPUQuota=60%
MemoryMax=3G
LimitNOFILE=1000000
StandardOutput=append:/home/ubuntu/sumo/validator.out

[Install]
WantedBy=multi-user.target
